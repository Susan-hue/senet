SECRET_KEY=generate-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://user:password@host:5432/dbname
CORS_ALLOWED_ORIGINS=http://localhost:5173

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
RESEND_API_KEY=re_your_api_key
EMAIL_HOST=smtp.resend.com
EMAIL_HOST_USER=resend
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Notifications — SMS / WhatsApp (Termii). Leave TERMII_API_KEY empty to use the
# console provider locally; nothing then reaches the network.
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Senet
TERMII_WHATSAPP_SENDER_ID=Senet
NOTIFICATIONS_WHATSAPP_ENABLED=False

# Shared secret Termii signs inbound SMS/USSD webhooks with. With no value set,
# the inbound endpoints reject every request.
TERMII_INBOUND_SECRET=

# Cache (rate limiting, USSD sessions, result-check lookups). Falls back to
# in-process memory when unset — set a Redis URL for anything multi-process.
CACHE_URL=
